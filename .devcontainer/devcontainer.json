{
  "name": "ai-build-night002",
  "image": "mcr.microsoft.com/devcontainers/python:3.13",
  "postCreateCommand": "pipx install uv==0.11.32 && uv sync",
  "forwardPorts": [
    8000
  ],
  "portsAttributes": {
    "8000": {
      "label": "app",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff"
      ]
    }
  }
}
